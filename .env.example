APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# CORS_ALLOWED_ORIGINS: orígenes permitidos para peticiones cross-origin del
# frontend, separados por coma (ej. http://localhost:3016,https://app.dominio.com)
CORS_ALLOWED_ORIGINS=http://localhost:3016
# ROOT_API_KEY: secreto inicial usado por AuthApiKeySeeder para crear la API
# Key root al hacer migrate --seed. Se hashea con SHA-256 antes de persistir.
# REGENERAR con `openssl rand -hex 32` antes de cualquier deploy.
ROOT_API_KEY="<generar-con-openssl-rand-hex-32>"
JWT_TTL=60 # Tiempo de vida del token JWT en minutos
REFRESH_TOKEN_TTL_MINUTES=90 # Tiempo de vida del token de refresco en minutos
API_KEY_PERMISSIONS_TTL=300 # Tiempo de vida de la caché de permisos de las API Keys en segundos
PERMISOS_EFECTIVOS_TTL=60 # Tiempo de vida de la caché de permisos efectivos por usuario en segundos
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_SV
APP_API_RATE_LIMIT=6000
# AUDIT_RELATIONAL_CONNECTION=pgsql   # opcional, por defecto usa DB_CONNECTION

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=app
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOGS_TTL=30
PASSWORD_RESET_TTL_MINUTES=5
PASSWORD_RESET_ATTEMPT_WINDOW_MINUTES=15
AUTH_TWO_FACTOR_WINDOW=1

#POSTGRES
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel-app
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# QUEUES - database (postgres)
QUEUE_CONNECTION=database
QUEUE_WORKER_QUEUES=default,request-logs
QUEUE_WORKER_NUMPROCS=1
QUEUE_WORKER_TIMEOUT=3600
QUEUE_WORKER_MEMORY=2048
QUEUE_WORKER_TRIES=1
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_STARTSECS=5
QUEUE_WORKER_STOPWAITSECS=600
SUPERVISOR_ENV=production

# CACHE
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Catálogos (12 horas)
CATALOG_CACHE_TTL=43200

# Tipos de Mail - log | smtp
# El tipo "log" permite registrar los correos en los logs de la aplicación
MAIL_MAILER=log
MAIL_LOG_CHANNEL=mail
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Google Cloud Storage
# ID del proyecto de GCP
GCS_PROJECT_ID=proyecto
# Nombre del bucket de almacenamiento
GCS_BUCKET=bucket-test-template
# Ruta absoluta al archivo JSON de credenciales del servicio
GCS_KEY_FILE=/var/www/html/key.json
# Prefijo opcional para almacenar archivos dentro de una carpeta del bucket
GCS_PREFIX=""
# URL pública que modifica el origen de los datos para el usuario final
GCS_PUBLIC_BASE_URL="https://storage.googleapis.com"

# Docker Configuration ---------
APP_PORT=8090
WWWUSER=1000
WWWGROUP=1000

# Database (Docker)
FORWARD_DB_PORT=5454

# Xdebug
SAIL_XDEBUG_MODE=off
SAIL_XDEBUG_CONFIG=client_host=host.docker.internal

VITE_THEME_LAYOUT=admin-sidebar

AUTH_2FA_ENFORCE_ALL=false
AUTH_2FA_REQUIRED_METHOD=email
AUTH_TWO_FACTOR_EMAIL_CODE_TTL_MINUTES=5

# IA (IA-BASE-01, D10). Sin OPENAI_API_KEY o con AI_PROVIDER=mock se usa el adaptador simulado.
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# Límite monetario global acumulado en USD (ausente/0 => agentes ocultos)
AI_BUDGET_USD=5
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=1000

# Datos de demostración del módulo académico (solo APP_ENV=local)
ACADEMICO_DEMO_SEED=true
