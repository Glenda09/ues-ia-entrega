# Control de versiones y CI
.git
.gitignore
.gitattributes
.github

# Dependencias (se instalan/copian dentro de la imagen)
vendor
node_modules

# Entorno y secretos (NO deben quedar horneados en la imagen)
.env
.env.*
!.env.example

# Cachés compiladas de Laravel: se regeneran en runtime. Hornearlas puede dejar
# referencias stale (p.ej. providers de dev-deps ausentes con --no-dev) y romper prod.
bootstrap/cache/*.php

# Artefactos volátiles de storage (la estructura se recrea en el entrypoint)
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*

# Archivos subidos o generados (documentos de aspirantes, PDF, logos): viven en el
# volumen compartido app-storage, nunca dentro de la imagen.
storage/app/**
!storage/app/.gitignore
!storage/app/private/.gitignore
!storage/app/public/.gitignore

# Assets compilados localmente: la imagen los genera en la etapa "assets".
public/build
public/hot
public/storage

# Credenciales locales
key.json
cors.json

# Tests, pruebas de carga y caches de herramientas
tests
stress
playwright.config.js
.phpunit.result.cache
.phpunit.cache

# Meta de repositorio y editores
*.md
.editorconfig
.idea
.vscode

# Artefactos de Docker (no se necesitan dentro de la imagen)
Dockerfile
.dockerignore
docker-compose*.yml
