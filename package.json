        "@vueuse/core": "^14.4.0",
        "axios": "^1.11.0",
        "dayjs": "^1.11.15",
        "dompurify": "^3.2.6",
        "jwt-decode": "^4.0.0",
        "marked": "^15.0.12",
        "pinia": "^3.0.3",
        "primeicons": "^7.0.0",
        "primevue": "^4.3.7",
        "qrcode": "^1.5.4",
        "tailwind-merge": "^3.3.1",
        "tailwindcss": "^4.1.12",
        "vue": "^3.5.18",
        "vue-router": "^4.5.1",
        "vue3-toastify": "^0.2.8"
    },
    "devDependencies": {
        "@playwright/test": "^1.55.0",
